{
  "uid": "shop-sla",
  "title": "shop — SLA заказа",
  "tags": ["shop", "lab4"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "p95 POST /order (окно 1m и 5m), порог SLA 100 ms",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"shop\",path=\"/order\"}[1m])))",
          "legendFormat": "p95, 1m"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"shop\",path=\"/order\"}[5m])))",
          "legendFormat": "p95, 5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.1 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "SLO: доля заказов быстрее 100 ms (окно 5m), цель 95%",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_bucket{namespace=\"shop\",path=\"/order\",le=\"0.1\"}[5m])) / sum(rate(http_request_duration_seconds_count{namespace=\"shop\",path=\"/order\"}[5m]))",
          "legendFormat": "≤ 100 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.8,
          "max": 1,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.95 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Ошибки 5xx POST /order (окно 1m), порог 1%",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{namespace=\"shop\",path=\"/order\",status=~\"5..\"}[1m])) / sum(rate(http_requests_total{namespace=\"shop\",path=\"/order\"}[1m]))",
          "legendFormat": "доля 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "RPS POST /order по статусам",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{namespace=\"shop\",path=\"/order\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "batch: Running против желаемого (деградирует он, а не критический путь)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=\"shop\",pod=~\"shop-batch.*\",phase=\"Running\"})",
          "legendFormat": "Running"
        },
        {
          "refId": "B",
          "expr": "sum(kube_deployment_spec_replicas{namespace=\"shop\",deployment=\"shop-batch\"})",
          "legendFormat": "желаемо"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "CPU throttling: доля периодов CFS с упором в limit",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"shop\",container=~\"api|postgres|batch\"}[1m])) / sum by (container) (rate(container_cpu_cfs_periods_total{namespace=\"shop\",container=~\"api|postgres|batch\"}[1m]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.25 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Память критического пути: working set / limit",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container) (container_memory_working_set_bytes{namespace=\"shop\",container=~\"api|postgres\"}) / max by (container) (kube_pod_container_resource_limits{namespace=\"shop\",container=~\"api|postgres\",resource=\"memory\"})",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.9 } ] }
        },
        "overrides": []
      }
    }
  ]
}
