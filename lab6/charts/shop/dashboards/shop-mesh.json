{
  "uid": "shop-mesh",
  "title": "shop — mesh и канарейка",
  "tags": [
    "shop",
    "lab6"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Доля ошибок по версиям (backend)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (version) (rate(response_total{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\",status_code=~\"5..\"}[1m])) or 0 * sum by (version) (rate(response_total{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\"}[1m]))) / sum by (version) (rate(response_total{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Задержка p95 по версиям, inbound-прокси",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, version) (rate(response_latency_ms_bucket{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\"}[1m])))",
          "legendFormat": "{{version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {},
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Разделение трафика по версиям",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version) (rate(response_total{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\"}[1m])) / ignoring(version) group_left sum(rate(response_total{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Вес v2 в HTTPRoute (скрипт-гейт)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gate_v2_weight{namespace=\"shop\"}",
          "legendFormat": "вес v2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {},
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Ошибки: backend и клиент",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(response_total{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\",status_code=~\"5..\"}[1m])) or vector(0)) / sum(rate(response_total{namespace=\"shop\",direction=\"inbound\",tls=\"true\",version!=\"\"}[1m]))",
          "legendFormat": "backend"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(outbound_http_route_request_statuses_total{namespace=\"shop\",parent_name=\"shop-api\",http_status=~\"5..\"}[1m])) or vector(0)) / sum(rate(outbound_http_route_request_statuses_total{namespace=\"shop\",parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "клиент"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {},
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Повторы на запрос клиента",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(outbound_http_route_retry_requests_total{namespace=\"shop\",parent_name=\"shop-api\"}[1m])) or vector(0)) / sum(rate(outbound_http_route_request_statuses_total{namespace=\"shop\",parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "retries / запрос"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {},
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
